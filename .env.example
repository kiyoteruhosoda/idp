# .env.example — single template for managing secrets and environment settings.
#
# Usage:
#   - On first run `deploy.sh` creates `.env` from this file, generating random secret values (CHANGE-ME).
#     Normally the only things to set by hand are the public URLs (ISSUER, PUBLIC_WEB_BASE_URL) and the published ports
#     (WEB_PORT, API_PORT). For the full picture of listening ports see docs/OPERATIONS.md
#     "待ち受けポート一覧".
#     To run stg/prod on the same host, use .env.staging.example / .env.production.example and
#     separate WEB_PORT, API_PORT and IMAGE_TAG per environment.
#   - For manual use, copy this file to `.env` and replace the CHANGE-ME values below with real values.
#   - `.env` is in .gitignore (never commit it). Only this file (.env.example) is committed.
#   - Docker Compose automatically loads `.env` in the same directory. The app/tests read it via dotenvy.
#     (Settings must always be read via the config module. Reading raw env directly is forbidden.)

# ---- OIDC / HTTP ----
# CHECK-ME: public URL of the api (OIDC protocol, JSON admin API). Change to an https domain in production.
# With the default domain-split it corresponds to the api's published port (API_PORT).
ISSUER=http://localhost:8070
# CHECK-ME: public URL of web (login screens, admin console). Corresponds to WEB_PORT.
PUBLIC_WEB_BASE_URL=http://localhost:8060
# CHECK-ME: web port published on the host (forwarded to the bundled reverse proxy's 8080).
# Don't publish Docker ports on all of the NAS's interfaces; limit them to local listening.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8060
DB_MAX_CONNECTIONS=10

# ---- Public topology (ADR-0015, ADR-0016) ----
# domain-split : web and api are split by listening port, and the front reverse proxy assigns separate
#                subdomains (default, ADR-0012). deploy.sh overlays docker-compose.domain-split.yml,
#                and WEB_PORT becomes web, API_PORT the api.
#                When running on public domains, set ISSUER, PUBLIC_WEB_BASE_URL and COOKIE_SECURE
#                (see "Publishing on separate domains" below).
# single-origin: one port (WEB_PORT) routes to web / api by path. In this case align ISSUER and
#                PUBLIC_WEB_BASE_URL to the same origin (= WEB_PORT).
PUBLISH_TOPOLOGY=domain-split
# Published port on the api side (must differ from WEB_PORT; forwarded to the bundled reverse proxy's 8081).
# Unused with single-origin.
API_BIND_HOST=127.0.0.1
API_PORT=8070

# ---- Deployment images ----
# Used to resolve built image names ${IMAGE_PREFIX}/{api,web,migrate}:${IMAGE_TAG}
# (shared by scripts/build.sh and Compose). For tar distribution (build.sh's dist/ bundle) the defaults are fine.
IMAGE_PREFIX=idp
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=idp

# ---- web service (ADR-0007; HTML screens + API client; no DB) ----
# Address the web container listens on (Compose injects 0.0.0.0:8081).
# WEB_BIND_ADDR=0.0.0.0:8081
# Base URL web uses to reach the api (no trailing slash). An internal server-to-server destination, independent of
# the public URL. Compose injects http://api:8080 (bypassing the proxy).
# API_BASE_URL=http://api:8080

# ---- MariaDB (shared with Compose's mariadb service) ----
MARIADB_DATABASE=idp
MARIADB_USER=idp
# CHANGE-ME: DB passwords (idp user / root). deploy.sh generates them randomly.
MARIADB_PASSWORD=CHANGE-ME
MARIADB_ROOT_PASSWORD=CHANGE-ME
# Bind address and port for publishing MariaDB on the host in dev Compose (loopback only by default).
# The deployment Compose does not publish MariaDB on the host by default. Overlay docker-compose.db-debug.yml only for maintenance.
MARIADB_BIND_HOST=127.0.0.1
MARIADB_PORT=3306

# ---- DATABASE_URL ----
# For sqlx-cli / cargo run from the host (web inside Compose resolves it separately via the mariadb service name).
# ${MARIADB_PASSWORD} is not expanded, so deploy.sh writes the real value (replace it when doing it manually).
DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp
# For integration tests (tests/ skip when unset). Points at the dev DB.
TEST_DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp

# ---- Signing key encryption key (base64, 32 bytes) ----
# CHANGE-ME: required in production. Generate with `openssl rand -base64 32` (deploy.sh generates it automatically).
KEY_ENCRYPTION_KEY=CHANGE-ME

# ---- Internal service auth token (ADR-0007 §5) ----
# CHANGE-ME: shared secret protecting web->api /internal/* calls (same value for api and web).
# deploy.sh generates it with `openssl rand -hex 32`. Compose requires this value (injected into both api and web).
INTERNAL_SERVICE_TOKEN=CHANGE-ME
# CHANGE-ME: CSRF HMAC key shared by api/web (base64, 32 bytes). deploy.sh generates it.
CSRF_SECRET=CHANGE-ME

# ---- Logging ----
# json | pretty
LOG_FORMAT=pretty
RUST_LOG=info,assay=debug

# ---- Cookie ----
# If unset, Secure is automatic when the service's own public origin is https. Leave false for local http.
# A shared setting used by both api and web. Can be overridden in the DB from the root settings screen, in which case the DB value wins
# (ADR-0013; restart both api and web to apply).
# COOKIE_SECURE=false

# ---- Redis (optional; profiles: optional; only when scaling) ----
REDIS_PASSWORD=redis
REDIS_PORT=6379

# ---- TTLs (seconds). Defaults when unset. Can be overridden in the DB from the root settings screen, in which case the DB value wins ----
# AUTH_SESSION_TTL_SECS is a shared setting used by both api and web (ADR-0013; applied by restarting both services).
# AUTH_SESSION_TTL_SECS=600
# AUTHORIZATION_CODE_TTL_SECS=60
# SSO_IDLE_TTL_SECS=28800
# SSO_ABSOLUTE_TTL_SECS=86400
# ACCESS_TOKEN_TTL_SECS=900
# Lifetime of access tokens for the admin API (the API that operates the IdP itself) (ADR-0037).
# The admin console fetches a new one per request, so it can be short; for system clients
# it is the upper bound of "from disabling until it actually stops".
# MANAGEMENT_TOKEN_TTL_SECS=300
# ID_TOKEN_TTL_SECS=3600
# REFRESH_TOKEN_TTL_SECS=2592000
# CLOCK_SKEW_SECS=60
# INVITATION_TTL_SECS=604800
# PASSWORD_RESET_TTL_SECS=3600
# EMAIL_VERIFICATION_TTL_SECS=86400
# TENANT_CACHE_TTL_SECS=60
# PERMISSION_CACHE_TTL_SECS=60

# ---- Signing key rotation (K2, ADR-0039) ----
# Publish the successor key to JWKS this many days before not_after (default 30 days).
# KEY_ROTATION_LEAD_DAYS=30
# Time from publishing the successor key until it starts signing (default 24 hours).
# Grace for relying parties caching JWKS to pick up the new kid. Make it longer than their cache TTL.
# 0 switches signing at the same time as publishing (verification at parties with a cache may fail).
# KEY_ROTATION_PUBLISH_LEAD_HOURS=24

# ---- Error/warning logs (`log` table; viewable from the admin console) ----
# Days to keep WARN / ERROR in the DB. Older rows are deleted hourly (default 30 days).
# 0 = never delete (the table grows without bound, so only if archived elsewhere).
# APP_LOG_RETENTION_DAYS=30

# ---- SSL accelerator / reverse proxy support (S1) ----
# Whether to trust X-Forwarded-For set by the reverse proxy (default false).
# When true, the first value of X-Forwarded-For is used as the real IP for audit logs and rate limiting.
# A shared setting used by both api and web (ADR-0013). When false the header is ignored and web uses the TCP peer
# address (the proxy's IP when behind a proxy). Set it to true behind a proxy.
# TRUST_FORWARDED_HEADERS=false
# HSTS max-age (seconds). 0 = no HSTS header (default 0).
# When running behind an HTTPS proxy, e.g.: HSTS_MAX_AGE=31536000
# A shared setting used by both api and web (ADR-0013; applied by restarting both services).
# HSTS_MAX_AGE=0

# ---- Publishing on separate domains (ADR-0015, ADR-0016, ADR-0018) ----
# Set when publishing the default domain-split on real domains (same values for api and web). Make the api a
# **child subdomain** of web (ADR-0018 decision 1; as a sibling, the COOKIE_DOMAIN for cleaning old cookies would spread
# up to the apex and cookie scopes would overlap across environments). Change ISSUER and PUBLIC_WEB_BASE_URL at the top
# to the public domains as follows, and set COOKIE_SECURE as well.
#   ISSUER=https://api.id.example.com           # api public origin (front proxy -> API_PORT)
#   PUBLIC_WEB_BASE_URL=https://id.example.com  # web public origin (front proxy -> WEB_PORT)
#   COOKIE_SECURE=true
# ISSUER and PUBLIC_WEB_BASE_URL must use the same scheme (mixing fails startup).
# PUBLIC_WEB_BASE_URL is the public base URL of web screens (the basis for the login handoff from /authorize and
# links in invitation/reset mails). Must be the same for api and web (no DB override). Defaults to ISSUER when unset.
# All cookies are web host-only (ADR-0018 decisions 2, 4). Set COOKIE_DOMAIN to the old value only during the migration
# period, to clean up Domain cookies left in browsers by the old ADR-0012 setup (unset it after cleanup).
# COOKIE_DOMAIN=example.com
