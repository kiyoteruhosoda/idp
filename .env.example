# .env.example — 秘密情報・環境設定の一元管理テンプレート。
#
# 使い方:
#   - `deploy.sh` が初回実行時に本ファイルを基に秘密値（CHANGE-ME）を乱数生成して `.env` を作る。
#     手動で設定するのは基本的に ISSUER（公開 URL）と WEB_PORT（公開ポート）だけでよい。
#     同一ホストに stg/prod を置く場合は .env.staging.example / .env.production.example を使い、
#     WEB_PORT と IMAGE_TAG を環境ごとに分ける。
#   - 手動で使う場合はこのファイルを `.env` にコピーし、下記 CHANGE-ME を実値へ置き換える。
#   - `.env` は .gitignore 済み（コミットしない）。本ファイル（.env.example）のみコミットする。
#   - Docker Compose は同ディレクトリの `.env` を自動読込する。アプリ/テストは dotenvy 経由で読む。
#     （設定取得は必ず config モジュール経由。生の env 直接参照は禁止。）

# ---- OIDC / HTTP ----
# CHECK-ME: 利用者がアクセスする公開 URL（本番では https のドメインに変更する）。
ISSUER=http://localhost:8060
# CHECK-ME: ホスト側で公開するポート（Compose のリバースプロキシ。単一オリジンで web/api を振り分ける）。
# Docker の公開ポートを NAS の全インターフェースへ出さず、ローカル待受に限定する。
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8060
DB_MAX_CONNECTIONS=10

# ---- デプロイ用イメージ ----
# ビルド済みイメージ名 ${IMAGE_PREFIX}/{api,web,migrate}:${IMAGE_TAG} の解決に使う
# （scripts/build.sh と Compose で共通）。tar 配布（build.sh の dist/ バンドル）では既定のままでよい。
IMAGE_PREFIX=idp
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=idp

# ---- web サービス（ADR-0007。HTML 画面＋API クライアント。DB 非依存） ----
# web が listen するアドレス。
# WEB_BIND_ADDR=0.0.0.0:8081
# web から api への到達先ベース URL（末尾スラッシュ無し）。単一オリジン構成ではプロキシ内部アドレス。
# API_BASE_URL=http://localhost:8060

# ---- MariaDB（Compose の mariadb サービスと共有） ----
MARIADB_DATABASE=idp
MARIADB_USER=idp
# CHANGE-ME: DB パスワード（idp ユーザー / root）。deploy.sh が乱数生成する。
MARIADB_PASSWORD=CHANGE-ME
MARIADB_ROOT_PASSWORD=CHANGE-ME
# 開発 Compose でホスト側に公開する MariaDB の bind 先とポート（既定は loopback のみ）。
# デプロイ Compose は既定で MariaDB をホスト公開しない。保守時だけ docker-compose.db-debug.yml を重ねる。
MARIADB_BIND_HOST=127.0.0.1
MARIADB_PORT=3306

# ---- DATABASE_URL ----
# ホストから実行する sqlx-cli / cargo run 用（Compose 内の web は mariadb サービス名で別途解決）。
# ${MARIADB_PASSWORD} は展開されないため、deploy.sh が実値で書き出す（手動時は置換すること）。
DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp
# 統合テスト用（tests/ は未設定時スキップ）。開発用 DB を指す。
TEST_DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp

# ---- 署名鍵の暗号化キー（base64、32 バイト） ----
# CHANGE-ME: 本番では必須。`openssl rand -base64 32` で生成（deploy.sh が自動生成）。
KEY_ENCRYPTION_KEY=CHANGE-ME

# ---- 内部サービス認証トークン（ADR-0007 §5） ----
# CHANGE-ME: web→api の /internal/* 呼び出しを保護する共有シークレット（api・web で同値）。
# deploy.sh が `openssl rand -hex 32` で生成する。Compose は本値を必須とする（api・web 双方へ注入）。
INTERNAL_SERVICE_TOKEN=CHANGE-ME
# CHANGE-ME: api/web 共有の CSRF HMAC 鍵（base64、32 バイト）。deploy.sh が生成する。
CSRF_SECRET=CHANGE-ME

# ---- ログ ----
# json | pretty
LOG_FORMAT=pretty
RUST_LOG=info,idp=debug

# ---- Cookie ----
# 未設定なら自サービスの公開オリジンが https のとき自動で Secure。http のローカルでは false のままでよい。
# api・web の両方が使う共有設定。root 設定画面から DB で上書きでき、その場合は DB 値が優先される
# （ADR-0013。反映には api・web 両方の再起動が必要）。
# COOKIE_SECURE=false

# ---- Redis（任意。profiles: optional。スケール時のみ） ----
REDIS_PASSWORD=redis
REDIS_PORT=6379

# ---- TTL（秒）。未設定時は既定値。root 設定画面から DB で上書きでき、その場合は DB 値が優先される ----
# AUTH_SESSION_TTL_SECS は api・web の両方が使う共有設定（ADR-0013。両サービスの再起動で反映）。
# AUTH_SESSION_TTL_SECS=600
# AUTHORIZATION_CODE_TTL_SECS=60
# SSO_IDLE_TTL_SECS=28800
# SSO_ABSOLUTE_TTL_SECS=86400
# ACCESS_TOKEN_TTL_SECS=900
# ID_TOKEN_TTL_SECS=3600
# REFRESH_TOKEN_TTL_SECS=2592000
# CLOCK_SKEW_SECS=60
# INVITATION_TTL_SECS=604800
# PASSWORD_RESET_TTL_SECS=3600
# EMAIL_VERIFICATION_TTL_SECS=86400
# TENANT_CACHE_TTL_SECS=60
# PERMISSION_CACHE_TTL_SECS=60

# ---- 署名鍵ローテーション（K2） ----
# not_after のこの日数前に次期鍵を自動生成して旧鍵を退役させる（既定 30 日）。
# KEY_ROTATION_LEAD_DAYS=30

# ---- SSL アクセラレーター / リバースプロキシ対応（S1） ----
# リバースプロキシが付与する X-Forwarded-For を信頼するか（既定 false）。
# true にすると X-Forwarded-For の先頭値を実 IP として監査ログ・レート制限に使う。
# TRUST_FORWARDED_HEADERS=false
# HSTS max-age（秒）。0 = HSTS ヘッダを付与しない（既定 0）。
# HTTPS プロキシ配下で運用する場合は例: HSTS_MAX_AGE=31536000
# api・web の両方が使う共有設定（ADR-0013。両サービスの再起動で反映）。
# HSTS_MAX_AGE=0

# ---- 公開 web URL ----
# web 画面の公開ベース URL（/authorize からのログイン・同意リダイレクトと招待/リセットメールの
# リンクの土台）。api・web で同値必須（DB 上書き不可）。未設定時は ISSUER。
# PUBLIC_WEB_BASE_URL=http://localhost:8060

# ---- 別ドメイン公開（ADR-0012） ----
# api と web を同一親ドメイン配下の別サブドメインで公開する場合のみ設定する。
# サービス横断 Cookie（sso_session_id / auth_session_id）に付与する Domain 属性。
# ISSUER・PUBLIC_WEB_BASE_URL 双方の親ドメインであること（起動時に検証。public suffix は不可）。
# 未設定 = host-only（単一オリジン構成の従来挙動）。api・web で同値必須。
# COOKIE_DOMAIN=example.com
