# .env.production.example — 同一ホストに stg/prod を置くための production 用サンプル。
#
# 使い方:
#   1. production 用ディレクトリへ dist/ を配置する
#   2. cp .env.production.example .env
#   3. CHANGE-ME を実値に置換する（公開ドメイン・ポートは idp.nolumia.com / idpapi.nolumia.com 用に
#      設定済み。別ホスト名で公開するなら ISSUER・PUBLIC_WEB_BASE_URL・COOKIE_DOMAIN を変更する）
#   4. IMAGE_TAG=prod ./scripts/build.sh dist-prod のように、prod 用タグで作った dist と組み合わせる
# 同一ホスト運用では WEB_PORT・API_PORT を stg と必ず分ける（prod=10000/10001・stg=10010/10011）。
# コンテナ内ポートは常に 8080（web 面）/ 8081（api 面）で、外部公開ポートだけが変わる。
# 待ち受けポートの全体像は docs/OPERATIONS.md「待ち受けポート一覧」を参照。

# ---- OIDC / HTTP（前段プロキシで TLS 終端する production） ----
# 既定の domain-split では api が API_PORT、web が WEB_PORT に出る。
#   https://idp.nolumia.com    → WEB_BIND_HOST:WEB_PORT(10000) → 同梱 nginx :8080 → web
#   https://idpapi.nolumia.com → API_BIND_HOST:API_PORT(10001) → 同梱 nginx :8081 → api
ISSUER=https://idpapi.nolumia.com
PUBLIC_WEB_BASE_URL=https://idp.nolumia.com
# Docker の公開ポートを NAS の全インターフェースへ出さず、ローカル待受に限定する。
WEB_BIND_HOST=127.0.0.1
WEB_PORT=10000
DB_MAX_CONNECTIONS=20

# ---- 公開トポロジ（ADR-0015・ADR-0016） ----
# domain-split : web（WEB_PORT）と api（API_PORT）をポートで分け、前段のリバースプロキシが
#                別サブドメインを割り当てる（既定。ADR-0012）。上の ISSUER・PUBLIC_WEB_BASE_URL は
#                公開ドメイン済みで、下の COOKIE_DOMAIN・COOKIE_SECURE・TRUST_FORWARDED_HEADERS・
#                HSTS_MAX_AGE も TLS 終端プロキシ前提の値にしてある。前段でまだ TLS を終端して
#                いない場合は 4 つを http 向け（COOKIE_SECURE=false・HSTS_MAX_AGE=0 等）へ戻す。
#                ISSUER と PUBLIC_WEB_BASE_URL はスキームを揃えること（混在は起動失敗）。
# single-origin: 1 ポート（WEB_PORT）をパスで web / api へ振り分ける。この場合は ISSUER と
#                PUBLIC_WEB_BASE_URL を WEB_PORT の同一オリジンに揃え、COOKIE_DOMAIN を削除する。
PUBLISH_TOPOLOGY=domain-split
# api 側の公開ポート。同一ホスト運用では stg（10011）と衝突しない値にする（single-origin では未使用）。
API_BIND_HOST=127.0.0.1
API_PORT=10001

# ---- デプロイ用イメージ（stg とタグを分け、同一ホストで latest を取り合わない） ----
IMAGE_PREFIX=idp
IMAGE_TAG=prod
COMPOSE_PROJECT_NAME=idp-prod

# ---- MariaDB ----
MARIADB_DATABASE=idp
MARIADB_USER=idp
MARIADB_PASSWORD=CHANGE-ME
MARIADB_ROOT_PASSWORD=CHANGE-ME
# デプロイ Compose は DB をホスト公開しない。保守用 override を使う場合も stg と衝突しない値にする。
MARIADB_BIND_HOST=127.0.0.1
MARIADB_PORT=3306

DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp
TEST_DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp

KEY_ENCRYPTION_KEY=CHANGE-ME
INTERNAL_SERVICE_TOKEN=CHANGE-ME
CSRF_SECRET=CHANGE-ME

LOG_FORMAT=json
RUST_LOG=info,idp=info
# サービス横断 Cookie の Domain 属性（先頭ドット不要）。idp / idpapi の共通の親ドメインにする。
# 注意: stg も同じ nolumia.com になるため、Cookie 名（sso_session_id・auth_session_id）は
#       prod と stg でブラウザ上共有される。同一ブラウザで両環境に同時ログインはできない。
COOKIE_DOMAIN=nolumia.com
# 前段プロキシで HTTPS 終端する前提の値。http 直結へ戻す場合は false / 0 にする。
COOKIE_SECURE=true
TRUST_FORWARDED_HEADERS=true
HSTS_MAX_AGE=31536000
