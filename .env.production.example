# .env.production.example — 同一ホストに stg/prod を置くための production 用サンプル。
#
# 使い方:
#   1. production 用ディレクトリへ dist/ を配置する
#   2. cp .env.production.example .env
#   3. CHANGE-ME を実値に置換し、外からアクセスするホスト名/IPに合わせて ISSUER を変更する
#   4. IMAGE_TAG=prod ./scripts/build.sh dist-prod のように、prod 用タグで作った dist と組み合わせる
# 同一ホスト運用では WEB_PORT を stg と必ず分ける。コンテナ内ポートは常に 8080、
# 外部公開ポートだけが WEB_PORT で変わる（例: http://<host>:8060）。
# 既定の公開ポート: prod = web 8060 / api 8061、stg = web 8065 / api 8066。

# ---- OIDC / HTTP（外部から http で接続する production） ----
ISSUER=http://localhost:8060
PUBLIC_WEB_BASE_URL=http://localhost:8060
# Docker の公開ポートを NAS の全インターフェースへ出さず、ローカル待受に限定する。
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8060
DB_MAX_CONNECTIONS=20

# ---- 公開トポロジ（ADR-0015） ----
# single-origin: 1 ポート（WEB_PORT）をパスで web / api へ振り分ける（既定）。
# domain-split : web（WEB_PORT）と api（API_PORT）をポートで分け、前段のリバースプロキシが
#                別サブドメインを割り当てる（ADR-0012）。その場合は上の ISSUER・
#                PUBLIC_WEB_BASE_URL を公開ドメインへ変更し、下記も設定する:
#                  ISSUER=https://api.example.com
#                  PUBLIC_WEB_BASE_URL=https://id.example.com
#                  COOKIE_SECURE=true
#                  COOKIE_DOMAIN=example.com
#                  TRUST_FORWARDED_HEADERS=true
#                  HSTS_MAX_AGE=31536000
#                ISSUER と PUBLIC_WEB_BASE_URL はスキームを揃えること（混在は起動失敗）。
PUBLISH_TOPOLOGY=single-origin
# domain-split のときだけ使う。同一ホスト運用では stg と衝突しない値にする。
API_BIND_HOST=127.0.0.1
API_PORT=8061

# ---- デプロイ用イメージ（stg とタグを分け、同一ホストで latest を取り合わない） ----
IMAGE_PREFIX=idp
IMAGE_TAG=prod
COMPOSE_PROJECT_NAME=idp-prod

# ---- MariaDB ----
MARIADB_DATABASE=idp
MARIADB_USER=idp
MARIADB_PASSWORD=CHANGE-ME
MARIADB_ROOT_PASSWORD=CHANGE-ME
# デプロイ Compose は DB をホスト公開しない。保守用 override を使う場合も stg と衝突しない値にする。
MARIADB_BIND_HOST=127.0.0.1
MARIADB_PORT=3306

DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp
TEST_DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3306/idp

KEY_ENCRYPTION_KEY=CHANGE-ME
INTERNAL_SERVICE_TOKEN=CHANGE-ME
CSRF_SECRET=CHANGE-ME

LOG_FORMAT=json
RUST_LOG=info,idp=info
# 外部 http 直結なら false。HTTPS 終端プロキシ配下にしたら true/未設定 + HSTS を検討する。
COOKIE_SECURE=false
TRUST_FORWARDED_HEADERS=false
HSTS_MAX_AGE=0
