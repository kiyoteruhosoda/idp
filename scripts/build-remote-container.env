# Settings for build-remote-container.sh (KEY=VALUE format; no command execution).
# Place next to the script. Leading-# comments and blank lines are ignored; surrounding whitespace of values is trimmed.
# Note: this is separate from the "deployment .env (secrets)" read by deploy.sh / Compose.
#
# {PROJECT} in values expands to the resolved project value.
# If the deployment directory layout is /<project name>/<environment> (e.g. /volume1/docker/idp/prod),
# the project name is taken automatically from the parent directory name, so PROJECT need not be set.
# Only if not following that layout, uncomment the line below to set the project name explicitly.
#PROJECT=idp
# Name of the dev container that performs the build
IDP_DEV_CONTAINER=ubuntu-dev
# User that runs the build inside the container
IDP_DEV_USER=sshuser
# Repository working dir inside the container (where scripts/build.sh lives)
IDP_DEV_WORKDIR=/work/project/{PROJECT}
# Absolute path of the built dist/ as seen from the host (required)
IDP_DIST_DIR=/var/services/homes/kyon/ubuntu-ssh/work/project/{PROJECT}/dist
