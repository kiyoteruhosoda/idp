# .env.staging.example — staging sample for running stg/prod on the same host.
#
# Usage:
#   1. Place dist/ in the staging directory
#   2. cp .env.staging.example .env
#   3. Replace CHANGE-ME with real values (public domains and ports are preset for idpstg.nolumia.com / identitystg.nolumia.com.
#      To publish under other host names, change ISSUER and PUBLIC_WEB_BASE_URL.
#      ADR-0019 decision 1: the api is a **sibling subdomain** of web (one label directly under the apex),
#      because a wildcard certificate covers only the leftmost label and sub-subdomains need a separate certificate.
#      With sibling naming, do not set COOKIE_DOMAIN (setting it spreads cookies up to the apex and
#      makes stg/prod cookie scopes overlap. Session cookies are host-only and need no sharing)
#   4. Combine with a dist built with the stg tag, e.g. IMAGE_TAG=stg ./scripts/build.sh dist-stg
# On a shared host, WEB_PORT and API_PORT must always differ from prod (stg=10010/10011, prod=10000/10001).
# In-container ports are always 8080 (web side) / 8081 (api side); only the published ports change.
# For the full picture of listening ports see docs/OPERATIONS.md "待ち受けポート一覧".

# ---- OIDC / HTTP (staging with TLS terminated at the front proxy) ----
# With the default domain-split, the api is on API_PORT and web on WEB_PORT (the api is a sibling subdomain of web,
# ADR-0019 decision 1).
#   https://idpstg.nolumia.com        → WEB_BIND_HOST:WEB_PORT(10010) → bundled nginx :8080 → web
#   https://identitystg.nolumia.com     → API_BIND_HOST:API_PORT(10011) → bundled nginx :8081 → api
# Both are one label directly under the apex, so a single wildcard certificate `*.nolumia.com` covers both
# (a wildcard covers only the leftmost label; sub-subdomains like `api.idpstg.nolumia.com` are not covered).
ISSUER=https://identitystg.nolumia.com
PUBLIC_WEB_BASE_URL=https://idpstg.nolumia.com
# Don't publish Docker ports on all of the NAS's interfaces; limit them to local listening.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=10010
DB_MAX_CONNECTIONS=10

# ---- Public topology (ADR-0015, ADR-0016) ----
# domain-split : web (WEB_PORT) and api (API_PORT) are split by port, and the front reverse proxy
#                assigns separate subdomains (api is web's sibling, ADR-0019 decision 1) (default, ADR-0016).
#                ISSUER and PUBLIC_WEB_BASE_URL above are already public domains, and COOKIE_SECURE,
#                TRUST_FORWARDED_HEADERS below are set assuming a TLS-terminating proxy. If the front does not
#                terminate TLS yet, revert to http values (COOKIE_SECURE=false, etc.).
#                ISSUER and PUBLIC_WEB_BASE_URL must use the same scheme (mixing fails startup).
# single-origin: one port (WEB_PORT) routes to web / api by path. In this case align ISSUER and
#                PUBLIC_WEB_BASE_URL to the same origin on WEB_PORT.
PUBLISH_TOPOLOGY=domain-split
# Published port on the api side. On a shared host, use a value that doesn't collide with prod (10001) (unused with single-origin).
API_BIND_HOST=127.0.0.1
API_PORT=10011

# ---- Deployment images (tag separately from prod so they don't fight over latest on the same host) ----
IMAGE_PREFIX=idp
IMAGE_TAG=stg
COMPOSE_PROJECT_NAME=idp-stg

# ---- MariaDB ----
MARIADB_DATABASE=idp
MARIADB_USER=idp
MARIADB_PASSWORD=CHANGE-ME
MARIADB_ROOT_PASSWORD=CHANGE-ME
# The deployment Compose doesn't publish the DB on the host. When using a maintenance override, also avoid colliding with prod.
MARIADB_BIND_HOST=127.0.0.1
MARIADB_PORT=3307

DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3307/idp
TEST_DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3307/idp

KEY_ENCRYPTION_KEY=CHANGE-ME
INTERNAL_SERVICE_TOKEN=CHANGE-ME
CSRF_SECRET=CHANGE-ME

LOG_FORMAT=pretty
RUST_LOG=info,assay=debug
# Don't set COOKIE_DOMAIN (ADR-0018 decision 4: session cookies are always host-only. With sibling naming,
# setting it spreads cookies up to the apex, so setting it is forbidden except for cleanup, ADR-0019).
# Only when migrating from the old setup (ADR-0012, cookies with Domain=nolumia.com), set the old value during the
# migration period to clean up Domain cookies left in browsers, and unset it once cleanup is done.
# COOKIE_DOMAIN=nolumia.com
# Values assuming HTTPS is terminated at the front proxy. To go back to plain http, set false.
COOKIE_SECURE=true
TRUST_FORWARDED_HEADERS=true
HSTS_MAX_AGE=0
