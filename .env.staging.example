# .env.staging.example — 同一ホストに stg/prod を置くための staging 用サンプル。
#
# 使い方:
#   1. staging 用ディレクトリへ dist/ を配置する
#   2. cp .env.staging.example .env
#   3. CHANGE-ME を実値に置換する（公開ドメイン・ポートは idpstg.nolumia.com / api.idpstg.nolumia.com
#      用に設定済み。別ホスト名で公開するなら ISSUER・PUBLIC_WEB_BASE_URL を変更する。
#      ADR-0018 決定 1: api は web の**子サブドメイン**にする。兄弟にすると Cookie 掃除用の
#      COOKIE_DOMAIN が apex まで広がり、stg/prod で Cookie スコープが交わるため）
#   4. IMAGE_TAG=stg ./scripts/build.sh dist-stg のように、stg 用タグで作った dist と組み合わせる
# 同一ホスト運用では WEB_PORT・API_PORT を prod と必ず分ける（stg=10010/10011・prod=10000/10001）。
# コンテナ内ポートは常に 8080（web 面）/ 8081（api 面）で、外部公開ポートだけが変わる。
# 待ち受けポートの全体像は docs/OPERATIONS.md「待ち受けポート一覧」を参照。

# ---- OIDC / HTTP（前段プロキシで TLS 終端する staging） ----
# 既定の domain-split では api が API_PORT、web が WEB_PORT に出る（api は web の子サブドメイン。
# ADR-0018 決定 1）。
#   https://idpstg.nolumia.com        → WEB_BIND_HOST:WEB_PORT(10010) → 同梱 nginx :8080 → web
#   https://api.idpstg.nolumia.com    → API_BIND_HOST:API_PORT(10011) → 同梱 nginx :8081 → api
# 証明書は web・api 両方のホスト名を SAN に含めること（`*.idpstg.nolumia.com` のワイルドカードは
# bare な `idpstg.nolumia.com` には一致しない。SAN = idpstg.nolumia.com + api.idpstg.nolumia.com）。
ISSUER=https://api.idpstg.nolumia.com
PUBLIC_WEB_BASE_URL=https://idpstg.nolumia.com
# Docker の公開ポートを NAS の全インターフェースへ出さず、ローカル待受に限定する。
WEB_BIND_HOST=127.0.0.1
WEB_PORT=10010
DB_MAX_CONNECTIONS=10

# ---- 公開トポロジ（ADR-0015・ADR-0016） ----
# domain-split : web（WEB_PORT）と api（API_PORT）をポートで分け、前段のリバースプロキシが
#                別サブドメイン（api は web の子。ADR-0018 決定 1）を割り当てる（既定。ADR-0016）。
#                上の ISSUER・PUBLIC_WEB_BASE_URL は公開ドメイン済みで、下の COOKIE_SECURE・
#                TRUST_FORWARDED_HEADERS も TLS 終端プロキシ前提の値にしてある。前段でまだ TLS を
#                終端していない場合は http 向け（COOKIE_SECURE=false 等）へ戻す。
#                ISSUER と PUBLIC_WEB_BASE_URL はスキームを揃えること（混在は起動失敗）。
# single-origin: 1 ポート（WEB_PORT）をパスで web / api へ振り分ける。この場合は ISSUER と
#                PUBLIC_WEB_BASE_URL を WEB_PORT の同一オリジンに揃える。
PUBLISH_TOPOLOGY=domain-split
# api 側の公開ポート。同一ホスト運用では prod（10001）と衝突しない値にする（single-origin では未使用）。
API_BIND_HOST=127.0.0.1
API_PORT=10011

# ---- デプロイ用イメージ（prod とタグを分け、同一ホストで latest を取り合わない） ----
IMAGE_PREFIX=idp
IMAGE_TAG=stg
COMPOSE_PROJECT_NAME=idp-stg

# ---- MariaDB ----
MARIADB_DATABASE=idp
MARIADB_USER=idp
MARIADB_PASSWORD=CHANGE-ME
MARIADB_ROOT_PASSWORD=CHANGE-ME
# デプロイ Compose は DB をホスト公開しない。保守用 override を使う場合も prod と衝突しない値にする。
MARIADB_BIND_HOST=127.0.0.1
MARIADB_PORT=3307

DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3307/idp
TEST_DATABASE_URL=mysql://idp:CHANGE-ME@127.0.0.1:3307/idp

KEY_ENCRYPTION_KEY=CHANGE-ME
INTERNAL_SERVICE_TOKEN=CHANGE-ME
CSRF_SECRET=CHANGE-ME

LOG_FORMAT=pretty
RUST_LOG=info,idp=debug
# COOKIE_DOMAIN は既定で設定しない（ADR-0018 決定 4: セッション Cookie は常に host-only）。
# 旧構成（ADR-0012。Domain=nolumia.com の Cookie）から移行する場合のみ、ブラウザに残った
# Domain 付き Cookie を掃除するため移行期間だけ旧値を設定し、掃除が済んだら未設定へ戻す。
# COOKIE_DOMAIN=nolumia.com
# 前段プロキシで HTTPS 終端する前提の値。http 直結へ戻す場合は false にする。
COOKIE_SECURE=true
TRUST_FORWARDED_HEADERS=true
HSTS_MAX_AGE=0
